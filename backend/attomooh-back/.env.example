# ==============================
# Application
# ==============================
PORT=3000
NODE_ENV=development

# ==============================
# CORS
# ==============================
FRONTEND_URL=http://localhost:5173
# OPTIONAL — additional allowed origin (e.g. a specific preview deployment).
FRONTEND_PREVIEW_URL=

# ==============================
# MongoDB Atlas Connection
# ==============================
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# ==============================
# JWT Configuration
# ==============================
JWT_SECRET=your_super_secret_key_change_me_in_production
JWT_EXPIRES_IN=7d

# ==============================
# Cloudinary Configuration
# ==============================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ==============================
# Admin Seed Configuration
# REQUIRED: ADMIN_PASSWORD — must be set to a strong password.
# Seeding refuses to start without it outside of development.
# ==============================
ADMIN_EMAIL=admin@company.com
# REQUIRED — do not use a default or guessable value.
ADMIN_PASSWORD=<set-a-strong-unique-password>
ADMIN_NAME=Admin
ADMIN_PHONE=05484584
BCRYPT_SALT_ROUNDS=10

# ==============================
# Technician Seed Configuration
# REQUIRED: TECH_PASSWORD — must be set to a strong password.
# Seeding refuses to start without it outside of development.
# ==============================
# REQUIRED — do not use a default or guessable value.
TECH_PASSWORD=<set-a-strong-unique-password>
