# ════════════════════════════════════════════
#  Attomooh Frontend — Environment Variables
# ════════════════════════════════════════════
# Copy this file to .env.local for local development
# or set these vars in your deployment platform for production.
# Vite inlines these at build time (npm run build).
# ════════════════════════════════════════════

# ── API ─────────────────────────────────────
# Backend API base URL (no trailing slash).
# For local dev: http://localhost:3000
# For production: https://your-backend-domain.com
VITE_API_BASE_URL=

# ── Dev Proxy Target ────────────────────────
# Only used by vite.config.ts for the /api proxy.
# Defaults to http://localhost:3000 if unset.
VITE_DEV_PROXY_TARGET=http://localhost:3000

# ── Cloudinary ──────────────────────────────
# Unsigned upload preset required.
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_upload_preset

# ── Contact Info ────────────────────────────
# Displayed in footer and contact page.
VITE_CONTACT_PHONE=+970599000000
VITE_CONTACT_WHATSAPP=+970599000000
VITE_CONTACT_EMAIL=your@email.com

# ── Branch Phones (WhatsApp) ───────────────
VITE_BRANCH_NABLUS_PHONE=+970599000000
VITE_BRANCH_HEBRON_PHONE=+970599000000
